@model List<AcunMedyaPortfolyo.Models.Tbl_Abaut>
<section style="background-color:pink" id="about" class="about section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2 style="font-size: 25px; color:purple;">About</h2>
        <p style="font-size: 15px; color:deeppink;">@Model[0].Description1</p>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">



        @foreach (var item in Model)
        {
            <div class="row gy-4 justify-content-center">
                <div class="col-lg-4">
                    <img src="@item.ImageURL" class="img-fluid rounded shadow" alt="Profile Photo" alt="">
                </div>
            </div>
                <div class="col-lg-8 content">
                    <h2 style="font-size: 60px; color:deeppink;">@item.Title</h2>
                    <p class="fst-italic py-3" style=" color:deeppink ; font-size:15px">
                        @item.Description1
                    </p>
                </div>
                    <div class="row">
                        <div class="col-lg-6">
                            <ul>
                                <li><i class="bi bi-chevron-right"> </i> <strong style="font-size: 18px; color: deeppink;">Birthday:</strong> <span>@item.BirthDay</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong style="font-size: 18px; color: deeppink;">Website:</strong> <span>@item.WebSite</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong style="font-size: 18px; color: deeppink;">Phone:</strong> <span>@item.Phone</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong style="font-size: 18px; color: deeppink;">City:</strong> <span>@item.City</span></li>
                            </ul>
                        </div>
                        <div class="col-lg-6">
                            <ul>
                                <li><i class="bi bi-chevron-right"></i> <strong style="font-size: 18px; color: deeppink;">Age:</strong> <span>@item.Age</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong style="font-size: 18px; color: deeppink;">Degree:</strong> <span>@item.Degree</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong style="font-size: 18px; color: deeppink;">Email:</strong> <span>@item.Email</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong style="font-size: 18px; color: deeppink;">Freelance:</strong> <span>@item.FreeLance</span></li>
                            </ul>
                            <p class="py-3"> </p>
                        </div>
                    </div>
                    }

                </div>
           

       

</section>
