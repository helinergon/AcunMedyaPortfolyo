@model List<AcunMedyaPortfolyo.Models.Tbl_Services>

<section style="background-color:pink" id="services" class="services section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2 style="font-size: 25px; color:purple;">Services</h2>
        <p style="font-size: 15px; color:deeppink;">Some of the services in which it is progressing towards specialization are listed below.</p>
    </div><!-- End Section Title -->

    <div class="container">

        <div class="row gy-4">

            @foreach (var item in Model)
            {
                <div class="col-xl-3 col-md-6 d-flex" data-aos="fade-up" data-aos-delay="100">
                    <div class="service-item position-relative">
                        <div class="icon"><i class="@item.IconUrl"></i></div>
                        <h4><a href="" class="stretched-link">@item.Title</a></h4>
                        <p>@item.Description</p>
                    </div>
                </div><!-- End Service Item -->

            }

        </div>

    </div>

</section>

