@model List<AcunMedyaPortfolyo.Models.Tbl_Job>

<div class="col-lg-6" data-aos="fade-up" data-aos-delay="200">
    <h3 style="font-size: 25px; color:purple;" class="resume-title">Experiences</h3>
    @foreach (var item in Model)
    {
        <div class="resume-item">
            <h4>@item.Title</h4>
            <h5>@item.StartDate</h5>
            <h5>@item.EndDate</h5>
            <p><em>@item.CompanyName </em></p>
            <ul>
                <li>@item.Description</li>
              
            </ul>
        </div><!-- Edn Resume Item -->

    }


</div>